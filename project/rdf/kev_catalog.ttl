@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
@prefix schema1: <http://schema.org/> .
<https://w3id.org/lmodel/kev-catalog/KevCatalog> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://schema.org/Dataset"^^xsd:anyURI , "https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Vocabularies/ExploitCatalogType/"^^xsd:anyURI , "https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset"^^xsd:anyURI , "https://www.wikidata.org/wiki/Q125498394"^^xsd:anyURI ;
	skos:broadMatch "dcat:Dataset"^^xsd:anyURI , "schema:Dataset"^^xsd:anyURI ;
	skos:editorialNote "DCAT 3 defines dcat:Catalog as a curated collection of metadata about resources such as datasets, and an entry here describes a vulnerability, so that mapping is only related despite the shared word. A KEV release is a kind of dataset, so dcat:Dataset and schema:Dataset are broader terms, not equivalents." , "Wikidata's Q125498394 is the KEV catalog itself, and SPDX 3.0.1's ExploitCatalogType/kev is its name for that catalog as a kind of exploit catalog. A class here is one release of it, so both are only related." ;
	skos:exactMatch "kev_catalog:KevCatalog"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:note "CISA's objects are open, so a key the schema does not name passes CISA's JSON schema. This class is closed, so a new key fails here until the schema names it." , "Each release is a whole file: the catalog is republished as a new file, with a new catalogVersion and dateReleased, when an entry is added or changed." ;
	skos:relatedMatch "dcat:Catalog"^^xsd:anyURI , "spdx3:Security/ExploitCatalogType/kev"^^xsd:anyURI , "wd:Q125498394"^^xsd:anyURI ;
	linkml:annotations _:c14n1 ;
	linkml:class_uri "https://w3id.org/lmodel/kev-catalog/KevCatalog"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/KevCatalog"^^xsd:anyURI ;
	linkml:description "One published release of the KEV catalog, with the entries it lists." ;
	linkml:slot_usage _:c14n40 ;
	linkml:slots <https://w3id.org/lmodel/kev-catalog/catalogVersion> , <https://w3id.org/lmodel/kev-catalog/count> , <https://w3id.org/lmodel/kev-catalog/dateReleased> , <https://w3id.org/lmodel/kev-catalog/title> , <https://w3id.org/lmodel/kev-catalog/vulnerabilities> ;
	linkml:tree_root true .
<https://w3id.org/lmodel/kev-catalog/KevForensicTriage> skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	linkml:annotations _:c14n45 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/KevForensicTriage"^^xsd:anyURI ;
	linkml:description "Whether BOD 26-04 calls for forensic triage of a vulnerability." ;
	linkml:permissible_values <https://w3id.org/lmodel/kev-catalog/No> , <https://w3id.org/lmodel/kev-catalog/Yes> .
<https://w3id.org/lmodel/kev-catalog/KevRansomwareCampaignUse> skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	linkml:annotations _:c14n39 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/KevRansomwareCampaignUse"^^xsd:anyURI ;
	linkml:description "What CISA can say about a vulnerability's use in ransomware campaigns." ;
	linkml:permissible_values <https://w3id.org/lmodel/kev-catalog/Known> , <https://w3id.org/lmodel/kev-catalog/Unknown> .
<https://w3id.org/lmodel/kev-catalog/KevVulnerability> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Classes/ExploitCatalogVulnAssessmentRelationship/"^^xsd:anyURI , "https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Classes/Vulnerability/"^^xsd:anyURI , "https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog_Record"^^xsd:anyURI , "https://www.wikidata.org/wiki/Q631425"^^xsd:anyURI ;
	skos:closeMatch "spdx3:Security/ExploitCatalogVulnAssessmentRelationship"^^xsd:anyURI ;
	skos:editorialNote "An entry is a statement in a catalog about a vulnerability, not the vulnerability itself. Wikidata's Q631425, STIX's vulnerability object and SPDX 3.0.1's Security/Vulnerability describe the weakness and carry nothing about exploitation or a required action, so each is only related. SPDX 3.0.1's Security/ExploitCatalogVulnAssessmentRelationship says that a vulnerability is listed in an exploit catalog, and names KEV as one, so it is close. dcat:CatalogRecord is related, since DCAT's record registers a dataset or a service." ;
	skos:exactMatch "kev_catalog:KevVulnerability"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:note "Four keys are optional in CISA's JSON schema though every entry of the pinned catalogue carries them: knownRansomwareCampaignUse, forensicTriage, notes and cwes. The schema follows CISA's JSON schema." ;
	skos:relatedMatch "cve:CveRecord"^^xsd:anyURI , "dcat:CatalogRecord"^^xsd:anyURI , "sepses_cve:CVE"^^xsd:anyURI , "spdx3:Security/Vulnerability"^^xsd:anyURI , "stix:StixVulnerability"^^xsd:anyURI , "wd:Q631425"^^xsd:anyURI ;
	linkml:annotations _:c14n12 ;
	linkml:class_uri "https://w3id.org/lmodel/kev-catalog/KevVulnerability"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/KevVulnerability"^^xsd:anyURI ;
	linkml:description "One entry of the KEV catalog, naming a CVE that CISA lists as exploited and the action it asks for by a due date." ;
	linkml:slot_usage _:c14n32 ;
	linkml:slots <https://w3id.org/lmodel/kev-catalog/cveID> , <https://w3id.org/lmodel/kev-catalog/cwes> , <https://w3id.org/lmodel/kev-catalog/dateAdded> , <https://w3id.org/lmodel/kev-catalog/dueDate> , <https://w3id.org/lmodel/kev-catalog/forensicTriage> , <https://w3id.org/lmodel/kev-catalog/knownRansomwareCampaignUse> , <https://w3id.org/lmodel/kev-catalog/notes> , <https://w3id.org/lmodel/kev-catalog/product> , <https://w3id.org/lmodel/kev-catalog/requiredAction> , <https://w3id.org/lmodel/kev-catalog/shortDescription> , <https://w3id.org/lmodel/kev-catalog/vendorProject> , <https://w3id.org/lmodel/kev-catalog/vulnerabilityName> .
<https://w3id.org/lmodel/kev-catalog/Known> linkml:description "CISA knows of a ransomware campaign that has used it." .
<https://w3id.org/lmodel/kev-catalog/No> linkml:description "The directive does not call for forensic triage of this vulnerability." .
<https://w3id.org/lmodel/kev-catalog/Unknown> linkml:description "CISA has no confirmation that a ransomware campaign has used it." .
<https://w3id.org/lmodel/kev-catalog/Yes> linkml:description "The directive calls for forensic triage of this vulnerability." .
<https://w3id.org/lmodel/kev-catalog/boolean> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"." ;
	skos:exactMatch "schema:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/linkml/Boolean"^^xsd:anyURI ;
	linkml:description "A binary (true or false) value" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "bool" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/catalogVersion> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://www.w3.org/TR/vocab-dcat-3/#Property:resource_version"^^xsd:anyURI ;
	skos:closeMatch "http://schema.org/version"^^xsd:anyURI ;
	skos:exactMatch "http://www.w3.org/ns/dcat#version"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/catalogVersion"^^xsd:anyURI ;
	skos:note "The value reads as a date, such as 2026.10.30, but CISA states only a string, so no pattern is given." ;
	linkml:annotations _:c14n44 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/catalogVersion"^^xsd:anyURI ;
	linkml:description "The version label of this release of the catalog." ;
	linkml:domain_of <https://w3id.org/lmodel/kev-catalog/KevCatalog> ;
	linkml:examples _:c14n8 ;
	linkml:owner <https://w3id.org/lmodel/kev-catalog/KevCatalog> ;
	linkml:range <https://w3id.org/lmodel/kev-catalog/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/kev-catalog/catalogVersion"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/count> a linkml:SlotDefinition ;
	skos:editorialNote "schema.org's numberOfItems is declared on ItemList, not Dataset, so the mapping is only related." ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/count"^^xsd:anyURI ;
	skos:note "CISA calls this the catalog's total. No validator here compares it with the list; tests/test_data.py does that in Python, over the examples and the pinned catalogue." ;
	skos:relatedMatch "http://schema.org/numberOfItems"^^xsd:anyURI ;
	linkml:annotations _:c14n46 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/count"^^xsd:anyURI ;
	linkml:description "How many entries CISA says the catalog holds." ;
	linkml:domain_of <https://w3id.org/lmodel/kev-catalog/KevCatalog> ;
	linkml:owner <https://w3id.org/lmodel/kev-catalog/KevCatalog> ;
	linkml:range <https://w3id.org/lmodel/kev-catalog/integer> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/kev-catalog/count"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/curie> dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations this MUST be expanded to a URI" , "in non-RDF serializations MAY be serialized as the compact representation" ;
	linkml:base "Curie" ;
	linkml:definition_uri "https://w3id.org/linkml/Curie"^^xsd:anyURI ;
	linkml:description "a compact URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/cveID> a linkml:SlotDefinition ;
	skos:editorialNote "Exact: a seeded sample of 120 entries on 2026-11-03 found each entry's value equal to cveMetadata.cveId in the CVE record of that name. Wikidata's P3587 holds the same identifier, in the same form, on the item for the vulnerability." ;
	skos:exactMatch "http://www.wikidata.org/prop/direct/P3587"^^xsd:anyURI , "https://w3id.org/lmodel/cve/cveId"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/cveID"^^xsd:anyURI ;
	linkml:annotations _:c14n6 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/cveID"^^xsd:anyURI ;
	linkml:description "The CVE identifier of the listed vulnerability, which identifies the entry." ;
	linkml:domain_of <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:examples _:c14n10 ;
	linkml:identifier true ;
	linkml:owner <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:pattern "^CVE-[0-9]{4}-[0-9]{4,19}$" ;
	linkml:range <https://w3id.org/lmodel/kev-catalog/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/kev-catalog/cveID"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/cwes> a linkml:SlotDefinition ;
	skos:closeMatch "http://www.wikidata.org/prop/direct/P3624"^^xsd:anyURI , "https://w3id.org/lmodel/cve/cweId"^^xsd:anyURI ;
	skos:editorialNote "Close, not exact: both give an entry's CWE codes, but in the sample of 120 entries the list equalled the codes of the CVE record's CNA and ADP containers together on 94. SEPSES's hasCWE links a CVE to a CWE resource, not a code, so it is only related. Wikidata's P3624 holds the CWE number alone, without the CWE- prefix CISA writes, so it is close." ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/cwes"^^xsd:anyURI ;
	skos:note "The list may be empty, as it is on some entries of the pinned catalogue." ;
	skos:relatedMatch "http://w3id.org/sepses/vocab/ref/cve#hasCWE"^^xsd:anyURI ;
	linkml:annotations _:c14n3 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/cwes"^^xsd:anyURI ;
	linkml:description "The CWE codes CISA associates with the vulnerability." ;
	linkml:domain_of <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:examples _:c14n0 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:pattern "^CWE-([0-9])+$" ;
	linkml:range <https://w3id.org/lmodel/kev-catalog/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/kev-catalog/cwes"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/date> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"." , "URI is dateTime because OWL reasoners don't work with straight date or time" ;
	skos:exactMatch "schema:Date"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDate" ;
	linkml:definition_uri "https://w3id.org/linkml/Date"^^xsd:anyURI ;
	linkml:description "a date (year, month and day) in an idealized calendar" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#date"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/dateAdded> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://www.w3.org/TR/vocab-dcat-3/#Property:record_listing_date"^^xsd:anyURI ;
	skos:closeMatch "http://purl.org/dc/terms/issued"^^xsd:anyURI ;
	skos:editorialNote "DCAT 3 uses dcterms:issued on a catalog record for the date of listing, of a dataset or service. An entry here lists a vulnerability, so the mapping is close. A CVE record repeats this date in CISA's ADP container, in a metric of type kev: on all 120 of the sample it was equal. That metric's content is free-form, so no slot mapping reaches it." ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/dateAdded"^^xsd:anyURI ;
	linkml:annotations _:c14n19 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/dateAdded"^^xsd:anyURI ;
	linkml:description "The day CISA added the vulnerability to the catalog." ;
	linkml:domain_of <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:examples _:c14n41 ;
	linkml:owner <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:range <https://w3id.org/lmodel/kev-catalog/date> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/kev-catalog/dateAdded"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/dateReleased> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://www.w3.org/TR/vocab-dcat-3/#Property:resource_release_date"^^xsd:anyURI ;
	skos:closeMatch "http://purl.org/dc/terms/issued"^^xsd:anyURI , "http://schema.org/datePublished"^^xsd:anyURI ;
	skos:editorialNote "DCAT 3's dcterms:issued is a resource's first known date of issuance. CISA's value moves with each release of a living catalog, so the mapping is close, not exact." ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/dateReleased"^^xsd:anyURI ;
	linkml:annotations _:c14n28 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/dateReleased"^^xsd:anyURI ;
	linkml:description "The date and time this release of the catalog came out." ;
	linkml:domain_of <https://w3id.org/lmodel/kev-catalog/KevCatalog> ;
	linkml:examples _:c14n21 ;
	linkml:owner <https://w3id.org/lmodel/kev-catalog/KevCatalog> ;
	linkml:range <https://w3id.org/lmodel/kev-catalog/datetime> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/kev-catalog/dateReleased"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/date_or_datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI ;
	linkml:description "Either a date or a datetime" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"." ;
	skos:exactMatch "schema:DateTime"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDateTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Datetime"^^xsd:anyURI ;
	linkml:description "The combination of a date and time" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/decimal> a linkml:TypeDefinition ;
	skos:broadMatch "schema:Number"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Decimal" ;
	linkml:definition_uri "https://w3id.org/linkml/Decimal"^^xsd:anyURI ;
	linkml:description "A real number with arbitrary precision that conforms to the xsd:decimal specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#decimal"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/double> a linkml:TypeDefinition ;
	skos:closeMatch "schema:Float"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Double"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:double specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/dueDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/dueDate"^^xsd:anyURI ;
	skos:note "CISA states no relation between this and dateAdded, so the schema adds none." ;
	linkml:annotations _:c14n17 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/dueDate"^^xsd:anyURI ;
	linkml:description "The day by which CISA wants the required action done." ;
	linkml:domain_of <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:examples _:c14n26 ;
	linkml:owner <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:range <https://w3id.org/lmodel/kev-catalog/date> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/kev-catalog/dueDate"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/float> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"." ;
	skos:exactMatch "schema:Float"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Float"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:float specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#float"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/forensicTriage> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/forensicTriage"^^xsd:anyURI ;
	skos:note "CISA types this as a string and names its two values only in the property's description, so the enum rests on that sentence and on the pinned catalogue." ;
	linkml:annotations _:c14n27 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/forensicTriage"^^xsd:anyURI ;
	linkml:description "Whether the vulnerability calls for forensic triage under BOD 26-04." ;
	linkml:domain_of <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:owner <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:range <https://w3id.org/lmodel/kev-catalog/KevForensicTriage> ;
	linkml:slot_uri "https://w3id.org/lmodel/kev-catalog/forensicTriage"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/integer> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"." ;
	skos:exactMatch "schema:Integer"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/linkml/Integer"^^xsd:anyURI ;
	linkml:description "An integer" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/kev-catalog/jsonpath> dcterms:conformsTo "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"." ;
