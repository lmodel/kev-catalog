<https://w3id.org/lmodel/kev-catalog/kev_catalog> dcterms:license "Apache-2.0" ;
	dcterms:source "https://github.com/cisagov/kev-data/blob/d98075f22b11ca60ede428f4397966d3523dc692/known_exploited_vulnerabilities_schema.json"^^xsd:anyURI ;
	dcterms:title "CISA Known Exploited Vulnerabilities Catalog" ;
	pav:version "2026-09-17" ;
	schema1:keywords "CISA" , "CVE" , "catalog" , "known exploited vulnerability" , "vulnerability" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://github.com/cisagov/kev-data"^^xsd:anyURI , "https://lmodel.github.io/kev-catalog"^^xsd:anyURI , "https://www.cisa.gov/known-exploited-vulnerabilities-catalog"^^xsd:anyURI , "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities_schema.json"^^xsd:anyURI ;
	skos:editorialNote "KEV's authority has moved to Binding Operational Directive (BOD) 26-04, which the upstream's README and its forensicTriage description cite. Directive terms, dates and counts belong at their source, so none is restated here. CISA's directive pages answered a plain client with 403 on 2026-11-03: see https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk" ;
	skos:note "CISA states its data's terms as CC0 1.0, and says that third-party links in the data keep their own terms and that use of the data gives no right to the CISA Logo or the DHS Seal and is no endorsement. NOTICE says the same." , "CISA's JSON schema states no version, so the version here is the date of the commit that last changed the file in cisagov/kev-data. tests/upstream/ copies the file, and scripts/check_upstream_release.py reports when it moves." ;
	sh:declare _:c14n11 , _:c14n13 , _:c14n14 , _:c14n16 , _:c14n20 , _:c14n25 , _:c14n31 , _:c14n33 , _:c14n34 , _:c14n35 , _:c14n36 , _:c14n47 ;
	linkml:annotations _:c14n15 , _:c14n23 , _:c14n37 , _:c14n4 , _:c14n5 ;
	linkml:classes <https://w3id.org/lmodel/kev-catalog/KevCatalog> , <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:default_prefix "kev_catalog" ;
	linkml:default_range <https://w3id.org/lmodel/kev-catalog/string> ;
	linkml:description "A LinkML model of the JSON format of the Known Exploited Vulnerabilities (KEV) catalog that the Cybersecurity and Infrastructure Security Agency (CISA) publishes. CISA's keys and values are the schema's, so a real KEV file validates unchanged." ;
	linkml:enums <https://w3id.org/lmodel/kev-catalog/KevForensicTriage> , <https://w3id.org/lmodel/kev-catalog/KevRansomwareCampaignUse> ;
	linkml:id "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	linkml:imports "linkml:types"^^xsd:anyURI ;
	linkml:metamodel_version "1.12.0" ;
	linkml:slots <https://w3id.org/lmodel/kev-catalog/catalogVersion> , <https://w3id.org/lmodel/kev-catalog/count> , <https://w3id.org/lmodel/kev-catalog/cveID> , <https://w3id.org/lmodel/kev-catalog/cwes> , <https://w3id.org/lmodel/kev-catalog/dateAdded> , <https://w3id.org/lmodel/kev-catalog/dateReleased> , <https://w3id.org/lmodel/kev-catalog/dueDate> , <https://w3id.org/lmodel/kev-catalog/forensicTriage> , <https://w3id.org/lmodel/kev-catalog/knownRansomwareCampaignUse> , <https://w3id.org/lmodel/kev-catalog/notes> , <https://w3id.org/lmodel/kev-catalog/product> , <https://w3id.org/lmodel/kev-catalog/requiredAction> , <https://w3id.org/lmodel/kev-catalog/shortDescription> , <https://w3id.org/lmodel/kev-catalog/title> , <https://w3id.org/lmodel/kev-catalog/vendorProject> , <https://w3id.org/lmodel/kev-catalog/vulnerabilities> , <https://w3id.org/lmodel/kev-catalog/vulnerabilityName> ;
	linkml:source_file "kev_catalog.yaml" ;
	linkml:source_file_date "2026-11-04T23:37:04"^^xsd:dateTime ;
	linkml:source_file_size 16964 ;
	linkml:types <https://w3id.org/lmodel/kev-catalog/boolean> , <https://w3id.org/lmodel/kev-catalog/curie> , <https://w3id.org/lmodel/kev-catalog/date> , <https://w3id.org/lmodel/kev-catalog/date_or_datetime> , <https://w3id.org/lmodel/kev-catalog/datetime> , <https://w3id.org/lmodel/kev-catalog/decimal> , <https://w3id.org/lmodel/kev-catalog/double> , <https://w3id.org/lmodel/kev-catalog/float> , <https://w3id.org/lmodel/kev-catalog/integer> , <https://w3id.org/lmodel/kev-catalog/jsonpath> , <https://w3id.org/lmodel/kev-catalog/jsonpointer> , <https://w3id.org/lmodel/kev-catalog/ncname> , <https://w3id.org/lmodel/kev-catalog/nodeidentifier> , <https://w3id.org/lmodel/kev-catalog/objectidentifier> , <https://w3id.org/lmodel/kev-catalog/sparqlpath> , <https://w3id.org/lmodel/kev-catalog/string> , <https://w3id.org/lmodel/kev-catalog/time> , <https://w3id.org/lmodel/kev-catalog/uri> , <https://w3id.org/lmodel/kev-catalog/uriorcurie> .
