<https://w3id.org/lmodel/kev-catalog/notes> a linkml:SlotDefinition ;
	skos:closeMatch "http://www.w3.org/2004/02/skos/core#note"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/notes"^^xsd:anyURI ;
	skos:note "Often holds addresses separated by \" ; \", with empty places between them. The schema keeps it one string and parses nothing, since CISA states no form for it. Those addresses are third parties', under their own terms." ;
