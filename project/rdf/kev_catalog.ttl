<https://w3id.org/lmodel/kev-catalog/requiredAction> a linkml:SlotDefinition ;
	skos:editorialNote "Related: a CVE record's solutions say what a CNA offers as a fix, and this says what CISA requires, often by pointing to the vendor's instructions. STIX's course-of-action is a kind of object, not a key, so no slot mapping reaches it." ;
	skos:inScheme "https://w3id.org/lmodel/kev-catalog"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/kev-catalog/requiredAction"^^xsd:anyURI ;
	skos:note "Free text. Older entries' text may name a directive since replaced, and the schema leaves the text as CISA wrote it." ;
	skos:relatedMatch "https://w3id.org/lmodel/cve/solutions"^^xsd:anyURI ;
	linkml:annotations _:c14n29 ;
	linkml:definition_uri "https://w3id.org/lmodel/kev-catalog/requiredAction"^^xsd:anyURI ;
	linkml:description "What CISA says must be done about the vulnerability." ;
	linkml:domain_of <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:owner <https://w3id.org/lmodel/kev-catalog/KevVulnerability> ;
	linkml:range <https://w3id.org/lmodel/kev-catalog/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/kev-catalog/requiredAction"^^xsd:anyURI .
