@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sepses_cve: <http://w3id.org/sepses/vocab/ref/cve#> .
@prefix kev_catalog: <https://w3id.org/lmodel/kev-catalog/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix spdx3: <https://spdx.org/rdf/3.0.1/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix stix: <https://w3id.org/lmodel/stix/> .
@prefix cve: <https://w3id.org/lmodel/cve/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
@prefix schema: <https://schema.org/> .
@prefix schema1: <http://schema.org/> .
<https://w3id.org/lmodel/kev-catalog.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/cisagov/kev-data/blob/d98075f22b11ca60ede428f4397966d3523dc692/known_exploited_vulnerabilities_schema.json> ;
	dcterms:title "CISA Known Exploited Vulnerabilities Catalog" ;
	pav:version "2026-09-17" ;
	schema1:keywords "CISA" , "CVE" , "catalog" , "known exploited vulnerability" , "vulnerability" ;
	a owl:Ontology ;
	rdfs:label "kev_catalog" ;
	rdfs:seeAlso <https://github.com/cisagov/kev-data> , <https://lmodel.github.io/kev-catalog> , <https://www.cisa.gov/known-exploited-vulnerabilities-catalog> , <https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities_schema.json> ;
	skos:definition "A LinkML model of the JSON format of the Known Exploited Vulnerabilities (KEV) catalog that the Cybersecurity and Infrastructure Security Agency (CISA) publishes. CISA's keys and values are the schema's, so a real KEV file validates unchanged." ;
	skos:editorialNote "KEV's authority has moved to Binding Operational Directive (BOD) 26-04, which the upstream's README and its forensicTriage description cite. Directive terms, dates and counts belong at their source, so none is restated here. CISA's directive pages answered a plain client with 403 on 2026-11-03: see https://www.cisa.gov/news-events/directives/bod-26-04-prioritizing-security-updates-based-risk" ;
	skos:note "CISA states its data's terms as CC0 1.0, and says that third-party links in the data keep their own terms and that use of the data gives no right to the CISA Logo or the DHS Seal and is no endorsement. NOTICE says the same." , "CISA's JSON schema states no version, so the version here is the date of the commit that last changed the file in cisagov/kev-data. tests/upstream/ copies the file, and scripts/check_upstream_release.py reports when it moves." ;
	kev_catalog:upstream_license "CC0-1.0" ;
	kev_catalog:upstream_schema_blob "ec422845b354f58250d2e99cdfcce17a18659423" ;
	kev_catalog:upstream_schema_commit "d98075f22b11ca60ede428f4397966d3523dc692" ;
	kev_catalog:upstream_schema_draft "http://json-schema.org/draft-07/schema#" ;
	kev_catalog:upstream_schema_sha256 "0d5865c98694c5bfba2c78a26caf814f406b3fce8bfb81bef79e99c7f288b0e7" .
kev_catalog:KevCatalog a owl:Class ;
	rdfs:label "KevCatalog" ;
	rdfs:seeAlso schema:Dataset , <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Vocabularies/ExploitCatalogType/> , <https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset> , <https://www.wikidata.org/wiki/Q125498394> ;
	rdfs:subClassOf _:c14n10 , _:c14n11 , _:c14n16 , _:c14n2 , _:c14n24 , _:c14n29 , _:c14n30 , _:c14n31 , _:c14n36 , _:c14n41 , _:c14n42 , _:c14n44 , _:c14n54 , _:c14n8 ;
	skos:broadMatch schema1:Dataset , dcat:Dataset ;
	skos:definition "One published release of the KEV catalog, with the entries it lists." ;
	skos:editorialNote "DCAT 3 defines dcat:Catalog as a curated collection of metadata about resources such as datasets, and an entry here describes a vulnerability, so that mapping is only related despite the shared word. A KEV release is a kind of dataset, so dcat:Dataset and schema:Dataset are broader terms, not equivalents." , "Wikidata's Q125498394 is the KEV catalog itself, and SPDX 3.0.1's ExploitCatalogType/kev is its name for that catalog as a kind of exploit catalog. A class here is one release of it, so both are only related." ;
	skos:exactMatch kev_catalog:KevCatalog ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "CISA's objects are open, so a key the schema does not name passes CISA's JSON schema. This class is closed, so a new key fails here until the schema names it." , "Each release is a whole file: the catalog is republished as a new file, with a new catalogVersion and dateReleased, when an entry is added or changed." ;
	skos:relatedMatch dcat:Catalog , wd:Q125498394 , spdx3:Security\/ExploitCatalogType\/kev ;
	kev_catalog:upstream_path "#" .
kev_catalog:KevForensicTriage\#No a owl:Class ;
	rdfs:label "No" ;
	rdfs:subClassOf kev_catalog:KevForensicTriage ;
	skos:definition "The directive does not call for forensic triage of this vulnerability." .
kev_catalog:KevForensicTriage\#Yes a owl:Class ;
	rdfs:label "Yes" ;
	rdfs:subClassOf kev_catalog:KevForensicTriage ;
	skos:definition "The directive calls for forensic triage of this vulnerability." .
kev_catalog:KevForensicTriage a owl:Class ;
	rdfs:label "KevForensicTriage" ;
	owl:unionOf _:c14n47 ;
	skos:definition "Whether BOD 26-04 calls for forensic triage of a vulnerability." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	linkml:permissible_values kev_catalog:KevForensicTriage\#No , kev_catalog:KevForensicTriage\#Yes ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/forensicTriage" .
kev_catalog:KevRansomwareCampaignUse\#Known a owl:Class ;
	rdfs:label "Known" ;
	rdfs:subClassOf kev_catalog:KevRansomwareCampaignUse ;
	skos:definition "CISA knows of a ransomware campaign that has used it." .
kev_catalog:KevRansomwareCampaignUse\#Unknown a owl:Class ;
	rdfs:label "Unknown" ;
	rdfs:subClassOf kev_catalog:KevRansomwareCampaignUse ;
	skos:definition "CISA has no confirmation that a ransomware campaign has used it." .
kev_catalog:KevRansomwareCampaignUse a owl:Class ;
	rdfs:label "KevRansomwareCampaignUse" ;
	owl:unionOf _:c14n28 ;
	skos:definition "What CISA can say about a vulnerability's use in ransomware campaigns." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	linkml:permissible_values kev_catalog:KevRansomwareCampaignUse\#Known , kev_catalog:KevRansomwareCampaignUse\#Unknown ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/knownRansomwareCampaignUse" .
kev_catalog:KevVulnerability a owl:Class ;
	rdfs:label "KevVulnerability" ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Classes/ExploitCatalogVulnAssessmentRelationship/> , <https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Classes/Vulnerability/> , <https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog_Record> , <https://www.wikidata.org/wiki/Q631425> ;
	rdfs:subClassOf _:c14n1 , _:c14n12 , _:c14n13 , _:c14n14 , _:c14n15 , _:c14n17 , _:c14n18 , _:c14n19 , _:c14n20 , _:c14n21 , _:c14n22 , _:c14n23 , _:c14n25 , _:c14n26 , _:c14n27 , _:c14n3 , _:c14n32 , _:c14n33 , _:c14n35 , _:c14n37 , _:c14n38 , _:c14n39 , _:c14n4 , _:c14n40 , _:c14n43 , _:c14n45 , _:c14n48 , _:c14n49 , _:c14n5 , _:c14n51 , _:c14n52 , _:c14n53 , _:c14n6 , _:c14n7 , _:c14n9 ;
	skos:closeMatch spdx3:Security\/ExploitCatalogVulnAssessmentRelationship ;
	skos:definition "One entry of the KEV catalog, naming a CVE that CISA lists as exploited and the action it asks for by a due date." ;
	skos:editorialNote "An entry is a statement in a catalog about a vulnerability, not the vulnerability itself. Wikidata's Q631425, STIX's vulnerability object and SPDX 3.0.1's Security/Vulnerability describe the weakness and carry nothing about exploitation or a required action, so each is only related. SPDX 3.0.1's Security/ExploitCatalogVulnAssessmentRelationship says that a vulnerability is listed in an exploit catalog, and names KEV as one, so it is close. dcat:CatalogRecord is related, since DCAT's record registers a dataset or a service." ;
	skos:exactMatch kev_catalog:KevVulnerability ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "Four keys are optional in CISA's JSON schema though every entry of the pinned catalogue carries them: knownRansomwareCampaignUse, forensicTriage, notes and cwes. The schema follows CISA's JSON schema." ;
	skos:relatedMatch sepses_cve:CVE , dcat:CatalogRecord , wd:Q631425 , spdx3:Security\/Vulnerability , cve:CveRecord , stix:StixVulnerability ;
	kev_catalog:upstream_path "#/$defs/vulnerability" .
kev_catalog:catalogVersion a owl:DatatypeProperty ;
	rdfs:label "catalogVersion" ;
	rdfs:range xsd:string ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:resource_version> ;
	skos:closeMatch schema1:version ;
	skos:definition "The version label of this release of the catalog." ;
	skos:exactMatch dcat:version ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "The value reads as a date, such as 2026.10.30, but CISA states only a string, so no pattern is given." ;
	kev_catalog:upstream_path "#/properties/catalogVersion" .
kev_catalog:count a owl:DatatypeProperty ;
	rdfs:label "count" ;
	rdfs:range xsd:integer ;
	skos:definition "How many entries CISA says the catalog holds." ;
	skos:editorialNote "schema.org's numberOfItems is declared on ItemList, not Dataset, so the mapping is only related." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "CISA calls this the catalog's total. No validator here compares it with the list; tests/test_data.py does that in Python, over the examples and the pinned catalogue." ;
	skos:relatedMatch schema1:numberOfItems ;
	kev_catalog:upstream_path "#/properties/count" .
kev_catalog:cveID a owl:DatatypeProperty ;
	rdfs:label "cveID" ;
	rdfs:range _:c14n50 ;
	skos:definition "The CVE identifier of the listed vulnerability, which identifies the entry." ;
	skos:editorialNote "Exact: a seeded sample of 120 entries on 2026-11-03 found each entry's value equal to cveMetadata.cveId in the CVE record of that name. Wikidata's P3587 holds the same identifier, in the same form, on the item for the vulnerability." ;
	skos:exactMatch wdt:P3587 , cve:cveId ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/cveID" .
kev_catalog:cwes a owl:DatatypeProperty ;
	rdfs:label "cwes" ;
	rdfs:range _:c14n34 ;
	skos:closeMatch wdt:P3624 , cve:cweId ;
	skos:definition "The CWE codes CISA associates with the vulnerability." ;
	skos:editorialNote "Close, not exact: both give an entry's CWE codes, but in the sample of 120 entries the list equalled the codes of the CVE record's CNA and ADP containers together on 94. SEPSES's hasCWE links a CVE to a CWE resource, not a code, so it is only related. Wikidata's P3624 holds the CWE number alone, without the CWE- prefix CISA writes, so it is close." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "The list may be empty, as it is on some entries of the pinned catalogue." ;
	skos:relatedMatch sepses_cve:hasCWE ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/cwes" .
kev_catalog:dateAdded a owl:DatatypeProperty ;
	rdfs:label "dateAdded" ;
	rdfs:range xsd:date ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:record_listing_date> ;
	skos:closeMatch dcterms:issued ;
	skos:definition "The day CISA added the vulnerability to the catalog." ;
	skos:editorialNote "DCAT 3 uses dcterms:issued on a catalog record for the date of listing, of a dataset or service. An entry here lists a vulnerability, so the mapping is close. A CVE record repeats this date in CISA's ADP container, in a metric of type kev: on all 120 of the sample it was equal. That metric's content is free-form, so no slot mapping reaches it." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/dateAdded" .
kev_catalog:dateReleased a owl:DatatypeProperty ;
	rdfs:label "dateReleased" ;
	rdfs:range xsd:dateTime ;
	rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:resource_release_date> ;
	skos:closeMatch dcterms:issued , schema1:datePublished ;
	skos:definition "The date and time this release of the catalog came out." ;
	skos:editorialNote "DCAT 3's dcterms:issued is a resource's first known date of issuance. CISA's value moves with each release of a living catalog, so the mapping is close, not exact." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	kev_catalog:upstream_path "#/properties/dateReleased" .
kev_catalog:dueDate a owl:DatatypeProperty ;
	rdfs:label "dueDate" ;
	rdfs:range xsd:date ;
	skos:definition "The day by which CISA wants the required action done." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "CISA states no relation between this and dateAdded, so the schema adds none." ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/dueDate" .
kev_catalog:forensicTriage a owl:ObjectProperty ;
	rdfs:label "forensicTriage" ;
	rdfs:range kev_catalog:KevForensicTriage ;
	skos:definition "Whether the vulnerability calls for forensic triage under BOD 26-04." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "CISA types this as a string and names its two values only in the property's description, so the enum rests on that sentence and on the pinned catalogue." ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/forensicTriage" .
kev_catalog:knownRansomwareCampaignUse a owl:ObjectProperty ;
	rdfs:label "knownRansomwareCampaignUse" ;
	rdfs:range kev_catalog:KevRansomwareCampaignUse ;
	skos:definition "Whether CISA knows of the vulnerability's use in a ransomware campaign." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "CISA types this as a string and names its two values only in the property's description, so the enum rests on that sentence and on the pinned catalogue." ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/knownRansomwareCampaignUse" .
kev_catalog:notes a owl:DatatypeProperty ;
	rdfs:label "notes" ;
	rdfs:range xsd:string ;
	skos:closeMatch skos:note ;
	skos:definition "Anything else CISA adds about the entry, as free text." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "Often holds addresses separated by \" ; \", with empty places between them. The schema keeps it one string and parses nothing, since CISA states no form for it. Those addresses are third parties', under their own terms." ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/notes" .
kev_catalog:product a owl:DatatypeProperty ;
	rdfs:label "product" ;
	rdfs:range xsd:string ;
	skos:closeMatch cve:product ;
	skos:definition "The affected product, as CISA names it." ;
	skos:editorialNote "Close, not exact: both name the affected product, but in the sample of 120 entries the value matched a CNA's affected product on only 14, as CNAs often name a release line or write n/a." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/product" .
kev_catalog:requiredAction a owl:DatatypeProperty ;
	rdfs:label "requiredAction" ;
	rdfs:range xsd:string ;
	skos:definition "What CISA says must be done about the vulnerability." ;
	skos:editorialNote "Related: a CVE record's solutions say what a CNA offers as a fix, and this says what CISA requires, often by pointing to the vendor's instructions. STIX's course-of-action is a kind of object, not a key, so no slot mapping reaches it." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "Free text. Older entries' text may name a directive since replaced, and the schema leaves the text as CISA wrote it." ;
	skos:relatedMatch cve:solutions ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/requiredAction" .
kev_catalog:shortDescription a owl:DatatypeProperty ;
	rdfs:label "shortDescription" ;
	rdfs:range xsd:string ;
	skos:definition "A brief account of the vulnerability, in CISA's words." ;
	skos:editorialNote "Related: this is CISA's own account. In the sample of 120 entries none equalled a description in the CVE record's CNA container." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:relatedMatch cve:descriptions ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/shortDescription" .
kev_catalog:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	rdfs:range xsd:string ;
	skos:definition "The catalog's human-readable name." ;
	skos:exactMatch dcterms:title ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:note "Every KEV file carries this key, though CISA's JSON schema lists it under no property. It is optional here for that reason." ;
	kev_catalog:upstream_file_key "title" .
kev_catalog:vendorProject a owl:DatatypeProperty ;
	rdfs:label "vendorProject" ;
	rdfs:range xsd:string ;
	skos:closeMatch cve:vendor ;
	skos:definition "The vendor or project behind the affected product, as CISA names it." ;
	skos:editorialNote "Close, not exact: both name who is responsible for the product, but in the sample of 120 entries the value matched the affected vendor that a CVE Numbering Authority (CNA) wrote on only 54, as CNAs often write a longer legal name or n/a." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/vendorProject" .
kev_catalog:vulnerabilities a owl:ObjectProperty ;
	rdfs:label "vulnerabilities" ;
	rdfs:range kev_catalog:KevVulnerability ;
	skos:broadMatch dcterms:hasPart ;
	skos:definition "The entries this release of the catalog lists." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	kev_catalog:upstream_path "#/properties/vulnerabilities" .
kev_catalog:vulnerabilityName a owl:DatatypeProperty ;
	rdfs:label "vulnerabilityName" ;
	rdfs:range xsd:string ;
	skos:definition "The name CISA gives the vulnerability." ;
	skos:editorialNote "Related: this is CISA's own wording. In the sample of 120 entries only 39 CVE records had a CNA title at all, and 2 of those equalled it." ;
	skos:inScheme <https://w3id.org/lmodel/kev-catalog> ;
	skos:relatedMatch cve:title ;
	kev_catalog:upstream_path "#/$defs/vulnerability/properties/vulnerabilityName" .
_:c14n0 rdf:first kev_catalog:KevRansomwareCampaignUse\#Unknown ;
	rdf:rest rdf:nil .
_:c14n1 a owl:Restriction ;
	owl:minCardinality 0 ;
	owl:onProperty kev_catalog:knownRansomwareCampaignUse .
_:c14n10 a owl:Restriction ;
	owl:allValuesFrom kev_catalog:KevVulnerability ;
	owl:onProperty kev_catalog:vulnerabilities .
_:c14n11 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty kev_catalog:count .
_:c14n12 a owl:Restriction ;
	owl:allValuesFrom xsd:string ;
	owl:onProperty kev_catalog:notes .
_:c14n13 a owl:Restriction ;
	owl:allValuesFrom kev_catalog:KevForensicTriage ;
	owl:onProperty kev_catalog:forensicTriage .
_:c14n14 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty kev_catalog:dateAdded .
_:c14n15 a owl:Restriction ;
	owl:allValuesFrom _:c14n58 ;
	owl:onProperty kev_catalog:cveID .
_:c14n16 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty kev_catalog:dateReleased .
_:c14n17 a owl:Restriction ;
	owl:allValuesFrom xsd:date ;
	owl:onProperty kev_catalog:dateAdded .
_:c14n18 a owl:Restriction ;
	owl:allValuesFrom xsd:string ;
	owl:onProperty kev_catalog:vendorProject .
_:c14n19 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty kev_catalog:product .
_:c14n2 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty kev_catalog:count .
_:c14n20 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty kev_catalog:shortDescription .
_:c14n21 a owl:Restriction ;
	owl:allValuesFrom xsd:string ;
	owl:onProperty kev_catalog:requiredAction .
_:c14n22 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty kev_catalog:forensicTriage .
_:c14n23 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty kev_catalog:requiredAction .
_:c14n24 a owl:Restriction ;
	owl:allValuesFrom xsd:integer ;
	owl:onProperty kev_catalog:count .
_:c14n25 a owl:Restriction ;
	owl:allValuesFrom xsd:string ;
	owl:onProperty kev_catalog:shortDescription .
_:c14n26 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty kev_catalog:vulnerabilityName .
_:c14n27 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty kev_catalog:shortDescription .
_:c14n28 rdf:first kev_catalog:KevRansomwareCampaignUse\#Known ;
	rdf:rest _:c14n0 .
_:c14n29 a owl:Restriction ;
	owl:allValuesFrom xsd:string ;
	owl:onProperty kev_catalog:title .
_:c14n3 a owl:Restriction ;
	owl:allValuesFrom xsd:date ;
	owl:onProperty kev_catalog:dueDate .
_:c14n30 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty kev_catalog:catalogVersion .
_:c14n31 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty kev_catalog:title .
_:c14n32 a owl:Restriction ;
	owl:allValuesFrom xsd:string ;
	owl:onProperty kev_catalog:product .
_:c14n33 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty kev_catalog:knownRansomwareCampaignUse .
_:c14n34 a rdfs:Datatype ;
	owl:intersectionOf _:c14n74 .
_:c14n35 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty kev_catalog:vendorProject .
_:c14n36 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty kev_catalog:dateReleased .
_:c14n37 a owl:Restriction ;
	owl:allValuesFrom kev_catalog:KevRansomwareCampaignUse ;
	owl:onProperty kev_catalog:knownRansomwareCampaignUse .
_:c14n38 a owl:Restriction ;
	owl:minCardinality 0 ;
	owl:onProperty kev_catalog:cwes .
_:c14n39 a owl:Restriction ;
	owl:allValuesFrom _:c14n64 ;
	owl:onProperty kev_catalog:cwes .
_:c14n4 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty kev_catalog:dateAdded .
_:c14n40 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty kev_catalog:cveID .
