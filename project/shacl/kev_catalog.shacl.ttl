@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix kev_catalog: <https://w3id.org/lmodel/kev-catalog/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
kev_catalog:KevCatalog a sh:NodeShape ;
	rdfs:comment "One published release of the KEV catalog, with the entries it lists." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n8 ;
	sh:property _:c14n16 , _:c14n20 , _:c14n22 , _:c14n4 , _:c14n7 ;
	sh:targetClass kev_catalog:KevCatalog .
kev_catalog:KevVulnerability a sh:NodeShape ;
	rdfs:comment "One entry of the KEV catalog, naming a CVE that CISA lists as exploited and the action it asks for by a due date." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n1 ;
	sh:property _:c14n0 , _:c14n10 , _:c14n11 , _:c14n13 , _:c14n14 , _:c14n15 , _:c14n18 , _:c14n19 , _:c14n21 , _:c14n3 , _:c14n5 , _:c14n6 ;
	sh:targetClass kev_catalog:KevVulnerability .
_:c14n0 sh:datatype xsd:string ;
	sh:description "The affected product, as CISA names it." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 2 ;
	sh:path kev_catalog:product .
_:c14n1 rdf:first rdf:type ;
	rdf:rest rdf:nil .
_:c14n10 sh:description "Whether the vulnerability calls for forensic triage under BOD 26-04." ;
	sh:in _:c14n12 ;
	sh:maxCount 1 ;
	sh:order 9 ;
	sh:path kev_catalog:forensicTriage .
_:c14n11 sh:datatype xsd:string ;
	sh:description "The name CISA gives the vulnerability." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 3 ;
	sh:path kev_catalog:vulnerabilityName .
_:c14n12 rdf:first "Yes" ;
	rdf:rest _:c14n17 .
_:c14n13 sh:datatype xsd:string ;
	sh:description "Anything else CISA adds about the entry, as free text." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 10 ;
	sh:path kev_catalog:notes .
_:c14n14 sh:datatype xsd:string ;
	sh:description "The vendor or project behind the affected product, as CISA names it." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 1 ;
	sh:path kev_catalog:vendorProject .
_:c14n15 sh:datatype xsd:string ;
	sh:description "The CWE codes CISA associates with the vulnerability." ;
	sh:nodeKind sh:Literal ;
	sh:order 11 ;
	sh:path kev_catalog:cwes ;
	sh:pattern "^CWE-([0-9])+$" .
_:c14n16 sh:datatype xsd:integer ;
	sh:description "How many entries CISA says the catalog holds." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 3 ;
	sh:path kev_catalog:count .
_:c14n17 rdf:first "No" ;
	rdf:rest rdf:nil .
_:c14n18 sh:datatype xsd:string ;
	sh:description "The CVE identifier of the listed vulnerability, which identifies the entry." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 0 ;
	sh:path kev_catalog:cveID ;
	sh:pattern "^CVE-[0-9]{4}-[0-9]{4,19}$" .
_:c14n19 sh:datatype xsd:string ;
	sh:description "What CISA says must be done about the vulnerability." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 6 ;
	sh:path kev_catalog:requiredAction .
_:c14n2 rdf:first "Known" ;
	rdf:rest _:c14n9 .
_:c14n20 sh:datatype xsd:string ;
	sh:description "The version label of this release of the catalog." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 1 ;
	sh:path kev_catalog:catalogVersion .
_:c14n21 sh:datatype xsd:date ;
	sh:description "The day by which CISA wants the required action done." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 7 ;
	sh:path kev_catalog:dueDate .
_:c14n22 sh:class kev_catalog:KevVulnerability ;
	sh:description "The entries this release of the catalog lists." ;
	sh:minCount 1 ;
	sh:nodeKind sh:IRI ;
	sh:order 4 ;
	sh:path kev_catalog:vulnerabilities .
_:c14n3 sh:description "Whether CISA knows of the vulnerability's use in a ransomware campaign." ;
	sh:in _:c14n2 ;
	sh:maxCount 1 ;
	sh:order 8 ;
	sh:path kev_catalog:knownRansomwareCampaignUse .
_:c14n4 sh:datatype xsd:dateTime ;
	sh:description "The date and time this release of the catalog came out." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 2 ;
	sh:path kev_catalog:dateReleased .
_:c14n5 sh:datatype xsd:date ;
	sh:description "The day CISA added the vulnerability to the catalog." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 4 ;
	sh:path kev_catalog:dateAdded .
_:c14n6 sh:datatype xsd:string ;
	sh:description "A brief account of the vulnerability, in CISA's words." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 5 ;
	sh:path kev_catalog:shortDescription .
_:c14n7 sh:datatype xsd:string ;
	sh:description "The catalog's human-readable name." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 0 ;
	sh:path kev_catalog:title .
_:c14n8 rdf:first rdf:type ;
	rdf:rest rdf:nil .
_:c14n9 rdf:first "Unknown" ;
	rdf:rest rdf:nil .
