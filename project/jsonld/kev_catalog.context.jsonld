{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "cve": "https://w3id.org/lmodel/cve/",
      "dcat": "http://www.w3.org/ns/dcat#",
      "dcterms": "http://purl.org/dc/terms/",
      "kev_catalog": "https://w3id.org/lmodel/kev-catalog/",
      "linkml": "https://w3id.org/linkml/",
      "schema": "http://schema.org/",
      "sepses_cve": "http://w3id.org/sepses/vocab/ref/cve#",
      "skos": "http://www.w3.org/2004/02/skos/core#",
      "spdx3": "https://spdx.org/rdf/3.0.1/terms/",
      "stix": "https://w3id.org/lmodel/stix/",
      "wd": "http://www.wikidata.org/entity/",
      "@vocab": "https://w3id.org/lmodel/kev-catalog/",
      "catalogVersion": {
         "@id": "catalogVersion"
      },
      "count": {
         "@type": "xsd:integer",
         "@id": "count"
      },
      "cveID": "@id",
      "cwes": {
         "@id": "cwes"
      },
      "dateAdded": {
         "@type": "xsd:date",
         "@id": "dateAdded"
      },
      "dateReleased": {
         "@type": "xsd:dateTime",
         "@id": "dateReleased"
      },
      "dueDate": {
         "@type": "xsd:date",
         "@id": "dueDate"
      },
      "forensicTriage": {
         "@context": {
            "text": "skos:notation",
            "description": "skos:prefLabel",
            "meaning": "@id"
         },
         "@id": "forensicTriage"
      },
      "knownRansomwareCampaignUse": {
         "@context": {
            "text": "skos:notation",
            "description": "skos:prefLabel",
            "meaning": "@id"
         },
         "@id": "knownRansomwareCampaignUse"
      },
      "notes": {
         "@id": "notes"
      },
      "product": {
         "@id": "product"
      },
      "requiredAction": {
         "@id": "requiredAction"
      },
      "shortDescription": {
         "@id": "shortDescription"
      },
      "title": {
         "@id": "title"
      },
      "vendorProject": {
         "@id": "vendorProject"
      },
      "vulnerabilities": {
         "@type": "@id",
         "@id": "vulnerabilities"
      },
      "vulnerabilityName": {
         "@id": "vulnerabilityName"
      },
      "KevCatalog": {
         "@id": "KevCatalog"
      },
      "KevVulnerability": {
         "@id": "KevVulnerability"
      }
   }
}
