      "imported_from": "linkml:types",
      "base": "str",
      "uri": "https://w3id.org/linkml/DateOrDatetime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uriorcurie",
      "definition_uri": "https://w3id.org/linkml/Uriorcurie",
      "description": "a URI or a CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "URIorCURIE",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "curie",
      "definition_uri": "https://w3id.org/linkml/Curie",
      "conforms_to": "https://www.w3.org/TR/curie/",
      "description": "a compact URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"."
      ],
      "comments": [
        "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "Curie",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uri",
      "definition_uri": "https://w3id.org/linkml/Uri",
      "conforms_to": "https://www.ietf.org/rfc/rfc3987.txt",
      "description": "a complete URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"."
      ],
      "comments": [
        "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:URL"
      ],
      "base": "URI",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "ncname",
      "definition_uri": "https://w3id.org/linkml/Ncname",
      "description": "Prefix part of CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NCName",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "objectidentifier",
      "definition_uri": "https://w3id.org/linkml/Objectidentifier",
      "description": "A URI or CURIE that represents an object in the model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"."
      ],
      "comments": [
        "Used for inheritance and type checking"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "ElementIdentifier",
      "uri": "http://www.w3.org/ns/shex#iri",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nodeidentifier",
      "definition_uri": "https://w3id.org/linkml/Nodeidentifier",
      "description": "A URI, CURIE or BNODE that represents a node in a model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "KevRansomwareCampaignUse",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/KevRansomwareCampaignUse",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/knownRansomwareCampaignUse"
        }
      ],
      "description": "What CISA can say about a vulnerability's use in ransomware campaigns.",
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "permissible_values": [
        {
          "text": "Known",
          "description": "CISA knows of a ransomware campaign that has used it."
        },
        {
          "text": "Unknown",
          "description": "CISA has no confirmation that a ransomware campaign has used it."
        }
      ]
    },
    {
      "name": "KevForensicTriage",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/KevForensicTriage",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/forensicTriage"
        }
      ],
      "description": "Whether BOD 26-04 calls for forensic triage of a vulnerability.",
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "permissible_values": [
        {
          "text": "Yes",
          "description": "The directive calls for forensic triage of this vulnerability."
        },
        {
          "text": "No",
          "description": "The directive does not call for forensic triage of this vulnerability."
        }
      ]
    }
  ],
  "slots": [
    {
      "name": "title",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/title",
      "annotations": [
        {
          "tag": "upstream_file_key",
          "value": "title",
          "@type": "Annotation"
        }
      ],
      "description": "The catalog's human-readable name.",
      "comments": [
        "Every KEV file carries this key, though CISA's JSON schema lists it under no property. It is optional here for that reason."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/title"
      ],
      "exact_mappings": [
        "http://purl.org/dc/terms/title"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/title",
      "owner": "KevCatalog",
      "domain_of": [
        "KevCatalog"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "catalogVersion",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/catalogVersion",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/properties/catalogVersion",
          "@type": "Annotation"
        }
      ],
      "description": "The version label of this release of the catalog.",
      "comments": [
        "The value reads as a date, such as 2026.10.30, but CISA states only a string, so no pattern is given."
      ],
      "examples": [
        {
          "value": "2026.10.30",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "see_also": [
        "https://www.w3.org/TR/vocab-dcat-3/#Property:resource_version"
      ],
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/catalogVersion"
      ],
      "exact_mappings": [
        "http://www.w3.org/ns/dcat#version"
      ],
      "close_mappings": [
        "http://schema.org/version"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/catalogVersion",
      "owner": "KevCatalog",
      "domain_of": [
        "KevCatalog"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "dateReleased",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/dateReleased",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/properties/dateReleased",
          "@type": "Annotation"
        }
      ],
      "description": "The date and time this release of the catalog came out.",
      "notes": [
        "DCAT 3's dcterms:issued is a resource's first known date of issuance. CISA's value moves with each release of a living catalog, so the mapping is close, not exact."
      ],
      "examples": [
        {
          "value": "2026-10-30T17:02:45.3665Z",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "see_also": [
        "https://www.w3.org/TR/vocab-dcat-3/#Property:resource_release_date"
      ],
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/dateReleased"
      ],
      "close_mappings": [
        "http://purl.org/dc/terms/issued",
        "http://schema.org/datePublished"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/dateReleased",
      "owner": "KevCatalog",
      "domain_of": [
        "KevCatalog"
      ],
      "range": "datetime",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "count",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/count",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/properties/count",
          "@type": "Annotation"
        }
      ],
      "description": "How many entries CISA says the catalog holds.",
      "notes": [
        "schema.org's numberOfItems is declared on ItemList, not Dataset, so the mapping is only related."
      ],
      "comments": [
        "CISA calls this the catalog's total. No validator here compares it with the list; tests/test_data.py does that in Python, over the examples and the pinned catalogue."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/count"
      ],
      "related_mappings": [
        "http://schema.org/numberOfItems"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/count",
      "owner": "KevCatalog",
      "domain_of": [
        "KevCatalog"
      ],
      "range": "integer",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "vulnerabilities",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/vulnerabilities",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/properties/vulnerabilities",
          "@type": "Annotation"
        }
      ],
      "description": "The entries this release of the catalog lists.",
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/vulnerabilities"
      ],
      "broad_mappings": [
        "http://purl.org/dc/terms/hasPart"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/vulnerabilities",
      "owner": "KevCatalog",
      "domain_of": [
        "KevCatalog"
      ],
      "range": "KevVulnerability",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "cveID",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/cveID",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/cveID",
          "@type": "Annotation"
        }
      ],
      "description": "The CVE identifier of the listed vulnerability, which identifies the entry.",
      "notes": [
        "Exact: a seeded sample of 120 entries on 2026-11-03 found each entry's value equal to cveMetadata.cveId in the CVE record of that name."
      ],
      "examples": [
        {
          "value": "CVE-2021-44228",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/cveID"
      ],
      "exact_mappings": [
        "https://w3id.org/lmodel/cve/cveId"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/cveID",
      "identifier": true,
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "string",
      "required": true,
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "vendorProject",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/vendorProject",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/vendorProject",
          "@type": "Annotation"
        }
      ],
      "description": "The vendor or project behind the affected product, as CISA names it.",
      "notes": [
        "Close, not exact: both name who is responsible for the product, but in the sample of 120 entries the value matched a CNA's affected vendor on only 54, as CNAs often write a longer legal name or n/a."
      ],
      "examples": [
        {
          "value": "Apache",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/vendorProject"
      ],
      "close_mappings": [
        "https://w3id.org/lmodel/cve/vendor"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/vendorProject",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "product",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/product",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/product",
          "@type": "Annotation"
        }
      ],
      "description": "The affected product, as CISA names it.",
      "notes": [
        "Close, not exact: both name the affected product, but in the sample of 120 entries the value matched a CNA's affected product on only 14, as CNAs often name a release line or write n/a."
      ],
      "examples": [
        {
          "value": "Log4j2",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/product"
      ],
      "close_mappings": [
        "https://w3id.org/lmodel/cve/product"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/product",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "vulnerabilityName",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/vulnerabilityName",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/vulnerabilityName",
          "@type": "Annotation"
        }
      ],
      "description": "The name CISA gives the vulnerability.",
      "notes": [
        "Related: this is CISA's own wording. In the sample of 120 entries only 39 CVE records had a CNA title at all, and 2 of those equalled it."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/vulnerabilityName"
      ],
      "related_mappings": [
        "https://w3id.org/lmodel/cve/title"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/vulnerabilityName",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "dateAdded",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/dateAdded",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/dateAdded",
          "@type": "Annotation"
        }
      ],
      "description": "The day CISA added the vulnerability to the catalog.",
      "notes": [
        "DCAT 3 uses dcterms:issued on a catalog record for the date of listing, of a dataset or service. An entry here lists a vulnerability, so the mapping is close."
      ],
      "examples": [
        {
          "value": "2021-12-10",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "see_also": [
        "https://www.w3.org/TR/vocab-dcat-3/#Property:record_listing_date"
      ],
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/dateAdded"
      ],
      "close_mappings": [
        "http://purl.org/dc/terms/issued"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/dateAdded",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "date",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "shortDescription",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/shortDescription",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/shortDescription",
          "@type": "Annotation"
        }
      ],
      "description": "A brief account of the vulnerability, in CISA's words.",
      "notes": [
        "Related: this is CISA's own account. In the sample of 120 entries none equalled a description in the CVE record's CNA container."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/shortDescription"
      ],
      "related_mappings": [
        "https://w3id.org/lmodel/cve/descriptions"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/shortDescription",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "requiredAction",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/requiredAction",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/requiredAction",
          "@type": "Annotation"
        }
      ],
      "description": "What CISA says must be done about the vulnerability.",
      "notes": [
        "Related: a CVE record's solutions say what a CNA offers as a fix, and this says what CISA requires, often by pointing to the vendor's instructions. STIX's course-of-action is a kind of object, not a key, so no slot mapping reaches it."
      ],
      "comments": [
        "Free text. Older entries' text may name a directive since replaced, and the schema leaves the text as CISA wrote it."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/requiredAction"
      ],
      "related_mappings": [
        "https://w3id.org/lmodel/cve/solutions"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/requiredAction",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "dueDate",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/dueDate",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/dueDate",
          "@type": "Annotation"
        }
      ],
      "description": "The day by which CISA wants the required action done.",
      "comments": [
        "CISA states no relation between this and dateAdded, so the schema adds none."
      ],
      "examples": [
        {
          "value": "2021-12-24",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/dueDate"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/dueDate",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "date",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "knownRansomwareCampaignUse",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/knownRansomwareCampaignUse",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/knownRansomwareCampaignUse",
          "@type": "Annotation"
        }
      ],
      "description": "Whether CISA knows of the vulnerability's use in a ransomware campaign.",
      "comments": [
        "CISA types this as a string and names its two values only in the property's description, so the enum rests on that sentence and on the pinned catalogue."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/knownRansomwareCampaignUse"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/knownRansomwareCampaignUse",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "KevRansomwareCampaignUse",
      "@type": "SlotDefinition"
    },
    {
      "name": "forensicTriage",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/forensicTriage",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/forensicTriage",
          "@type": "Annotation"
        }
      ],
      "description": "Whether the vulnerability calls for forensic triage under BOD 26-04.",
      "comments": [
        "CISA types this as a string and names its two values only in the property's description, so the enum rests on that sentence and on the pinned catalogue."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/forensicTriage"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/forensicTriage",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "KevForensicTriage",
      "@type": "SlotDefinition"
    },
    {
      "name": "notes",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/notes",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/notes",
          "@type": "Annotation"
        }
      ],
      "description": "Anything else CISA adds about the entry, as free text.",
      "comments": [
        "Often holds addresses separated by \" ; \", with empty places between them. The schema keeps it one string and parses nothing, since CISA states no form for it. Those addresses are third parties', under their own terms."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/notes"
      ],
      "close_mappings": [
        "http://www.w3.org/2004/02/skos/core#note"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/notes",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "cwes",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/cwes",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability/properties/cwes",
          "@type": "Annotation"
        }
      ],
      "description": "The CWE codes CISA associates with the vulnerability.",
      "notes": [
        "Close, not exact: both give an entry's CWE codes, but in the sample of 120 entries the list equalled the codes of the CVE record's CNA and ADP containers together on 94. SEPSES's hasCWE links a CVE to a CWE resource, not a code, so it is only related."
      ],
      "comments": [
        "The list may be empty, as it is on some entries of the pinned catalogue."
      ],
      "examples": [
        {
          "value": "CWE-502",
          "@type": "Example"
        }
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "mappings": [
        "https://w3id.org/lmodel/kev-catalog/cwes"
      ],
      "close_mappings": [
        "https://w3id.org/lmodel/cve/cweId"
      ],
      "related_mappings": [
        "http://w3id.org/sepses/vocab/ref/cve#hasCWE"
      ],
      "slot_uri": "https://w3id.org/lmodel/kev-catalog/cwes",
      "owner": "KevVulnerability",
      "domain_of": [
        "KevVulnerability"
      ],
      "range": "string",
      "multivalued": true,
      "pattern": "^CWE-([0-9])+$",
      "@type": "SlotDefinition"
    }
  ],
  "classes": [
    {
      "name": "KevCatalog",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/KevCatalog",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#",
          "@type": "Annotation"
        }
      ],
      "description": "One published release of the KEV catalog, with the entries it lists.",
      "notes": [
        "DCAT 3 defines dcat:Catalog as a curated collection of metadata about resources such as datasets, and an entry here describes a vulnerability, so that mapping is only related despite the shared word. A KEV release is a kind of dataset, so dcat:Dataset and schema:Dataset are broader terms, not equivalents."
      ],
      "comments": [
        "Each release is a whole file: the catalog is republished as a new file, with a new catalogVersion and dateReleased, when an entry is added or changed.",
        "CISA's objects are open, so a key the schema does not name passes CISA's JSON schema. This class is closed, so a new key fails here until the schema names it."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "see_also": [
        "https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset",
        "https://schema.org/Dataset"
      ],
      "exact_mappings": [
        "kev_catalog:KevCatalog"
      ],
      "related_mappings": [
        "dcat:Catalog"
      ],
      "broad_mappings": [
        "dcat:Dataset",
        "schema:Dataset"
      ],
      "slots": [
        "title",
        "catalogVersion",
        "dateReleased",
        "count",
        "vulnerabilities"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/kev-catalog/KevCatalog",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "KevVulnerability",
      "definition_uri": "https://w3id.org/lmodel/kev-catalog/KevVulnerability",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "#/$defs/vulnerability",
          "@type": "Annotation"
        }
      ],
      "description": "One entry of the KEV catalog, naming a CVE that CISA lists as exploited and the action it asks for by a due date.",
      "notes": [
        "An entry is a statement in a catalog about a vulnerability, not the vulnerability itself. Wikidata's Q631425, STIX's vulnerability object and SPDX 3.0.1's Security/Vulnerability describe the weakness and carry nothing about exploitation or a required action, so each is only related. SPDX 3.0.1's Security/ExploitCatalogVulnAssessmentRelationship says that a vulnerability is listed in an exploit catalog, and names KEV as one, so it is close. dcat:CatalogRecord is related, since DCAT's record registers a dataset or a service."
      ],
      "comments": [
        "Four keys are optional in CISA's JSON schema though every entry of the pinned catalogue carries them: knownRansomwareCampaignUse, forensicTriage, notes and cwes. The schema follows CISA's JSON schema."
      ],
      "from_schema": "https://w3id.org/lmodel/kev-catalog",
      "see_also": [
        "https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Classes/ExploitCatalogVulnAssessmentRelationship/",
        "https://spdx.github.io/spdx-spec/v3.0.1/model/Security/Classes/Vulnerability/",
        "https://www.wikidata.org/wiki/Q631425",
        "https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog_Record"
      ],
      "exact_mappings": [
        "kev_catalog:KevVulnerability"
      ],
      "close_mappings": [
        "spdx3:Security/ExploitCatalogVulnAssessmentRelationship"
      ],
      "related_mappings": [
        "wd:Q631425",
        "stix:StixVulnerability",
        "spdx3:Security/Vulnerability",
        "sepses_cve:CVE",
        "dcat:CatalogRecord",
        "cve:CveRecord"
      ],
      "slots": [
        "cveID",
        "vendorProject",
        "product",
        "vulnerabilityName",
        "dateAdded",
        "shortDescription",
        "requiredAction",
        "dueDate",
        "knownRansomwareCampaignUse",
        "forensicTriage",
        "notes",
        "cwes"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/kev-catalog/KevVulnerability",
      "@type": "ClassDefinition"
    }
  ],
  "metamodel_version": "1.12.0",
  "source_file": "kev_catalog.yaml",
  "source_file_date": "2026-11-03T21:32:29",
  "source_file_size": 15875,
  "@type": "SchemaDefinition",
